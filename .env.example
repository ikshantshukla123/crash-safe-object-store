# Copy to .env and fill in the blanks:  cp .env.example .env
# .env is gitignored. Never commit real secrets (CLAUDE.md §12, §17).

# ---- API ----
API_ADDR=:8080
LOG_LEVEL=info
DEMO_MODE=false

# ---- Postgres (source of truth for all metadata, §3.1) ----
POSTGRES_USER=objstore
POSTGRES_PASSWORD=
POSTGRES_DB=objstore
DATABASE_URL=postgres://objstore:CHANGEME@postgres:5432/objstore?sslmode=disable

# ---- Redis (cache + job queue; derived data only, never a source of truth) ----
REDIS_ADDR=redis:6379

# ---- Security (§12) ----
JWT_SECRET=
JWT_TTL=15m
PRESIGN_KEY_ID=k1
PRESIGN_SECRET=
PRESIGN_MAX_EXPIRY=168h
DEMO_TOKEN=

# ---- Replication + chunking (§16 constants) ----
REPLICAS_N=3
WRITE_QUORUM_W=2
DEFAULT_PART_SIZE_BYTES=8388608
MAX_PART_SIZE_BYTES=16777216

# ---- WAL (§8) ----
WAL_DIR=/data/wal
WAL_SEGMENT_BYTES=67108864

# ---- Workers (§16) ----
HEALTH_INTERVAL=2s
HEALTH_DOWN_THRESHOLD=3
HEALTH_UP_THRESHOLD=2
REPLICATOR_BATCH=50
REPLICATOR_CONCURRENCY=4
MULTIPART_EXPIRY=24h
GC_ORPHAN_GRACE=24h

# ---- Cache (§11) ----
META_CACHE_TTL=60s
SMALL_OBJECT_CACHE_LIMIT_BYTES=1048576

# ---- Embeddings (§16) — Phase 10, optional ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=
