# Copy to .env and fill in the blanks:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

# ---- API ----
API_ADDR=:8080
LOG_LEVEL=info
DEMO_MODE=false

# ---- Postgres (source of truth for all metadata) ----
POSTGRES_USER=objstore
POSTGRES_PASSWORD=
POSTGRES_DB=objstore
# Host ports for the published containers. Defaults avoid colliding with a
# Postgres or Redis already installed natively on your machine.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# DATABASE_URL here is for tools run ON THE HOST (go test, migrate, psql), so
# it uses localhost and the published port. Containers do not read this value:
# deploy/docker-compose.yml injects its own URL using the service name
# `postgres` and the internal port 5432.
DATABASE_URL=postgres://objstore:CHANGEME@localhost:5433/objstore?sslmode=disable

# ---- Redis (cache + job queue; derived data only, never a source of truth) ----
REDIS_ADDR=localhost:6379

# ---- Security ----
JWT_SECRET=
JWT_TTL=15m
PRESIGN_KEY_ID=k1
PRESIGN_SECRET=
PRESIGN_MAX_EXPIRY=168h
DEMO_TOKEN=

# ---- Replication + chunking ----
REPLICAS_N=3
WRITE_QUORUM_W=2
DEFAULT_PART_SIZE_BYTES=8388608
MAX_PART_SIZE_BYTES=16777216

# ---- WAL ----
WAL_DIR=/data/wal
WAL_SEGMENT_BYTES=67108864

# ---- Workers ----
HEALTH_INTERVAL=2s
HEALTH_DOWN_THRESHOLD=3
HEALTH_UP_THRESHOLD=2
REPLICATOR_BATCH=50
REPLICATOR_CONCURRENCY=4
MULTIPART_EXPIRY=24h
GC_ORPHAN_GRACE=24h

# ---- Cache ----
META_CACHE_TTL=60s
SMALL_OBJECT_CACHE_LIMIT_BYTES=1048576

# ---- Embeddings (optional) ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=
